worker_processes 1;
pid /tmp/kurokuro-proxy.pid;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

http {
  access_log /dev/stdout;
  client_body_temp_path /tmp/nginx-client-body;
  proxy_temp_path /tmp/nginx-proxy;
  client_max_body_size 1m;
  client_header_timeout 10s;
  client_body_timeout 10s;
  send_timeout 15s;

  map $http_x_kurokuro_token $kurokuro_authorized {
    default 0;
    "__KUROKURO_API_TOKEN__" 1;
  }

  # Shared global ceiling protects the small free instance from request floods.
  limit_req_zone $server_name zone=kurokuro_search:1m rate=8r/s;

  server {
    listen 7860;
    server_name _;

    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    location / {
      if ($kurokuro_authorized = 0) {
        return 401;
      }

      limit_req zone=kurokuro_search burst=12 nodelay;
      limit_req_status 429;

      proxy_pass http://127.0.0.1:8080;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 3s;
      proxy_read_timeout 12s;
      proxy_send_timeout 12s;
    }
  }
}
